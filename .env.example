# Copy to .env and fill in the secrets. Never commit .env.

# Runtime environment: development | staging | production
APP_ENV=development
# Port the bridge listens on (ngrok forwards to it).
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info

# TMS (from the candidate portal).
TMS_HOST=tramway.proxy.rlwy.net
TMS_PORT=17159
# Secret: TMS auth token from the candidate portal.
TMS_TOKEN=

# Secret: FMCSA API web key from the candidate portal.
FMCSA_API_KEY=
# Optional: MC for local FMCSA checks (digits or MC prefix). See README test carriers.
# FMCSA_PROBE_MC=136818

# Secret: API key the bridge accepts as a Bearer token. Generate with: openssl rand -hex 32
BRIDGE_API_KEY=

# Local tunnel only (`make tunnel`). The bridge process does not read this.
NGROK_DOMAIN=haggler-tinsmith-statute.ngrok-free.dev
